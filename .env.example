# Application
NODE_ENV=development
APP_PORT=3000
APP_TZ=Asia/Kolkata
LOG_LEVEL=info

# Database (local store of all prices, metrics, scores)
DATABASE_URL=postgres://scanner:scanner@localhost:5432/sector_scanner

# ---------------------------------------------------------------------------
# DATA ARCHITECTURE
# Official/authorized source → local database → calculations → dashboard
#
# The dashboard NEVER fetches live market data. It only reads precomputed
# rows from Postgres.
#
# DATA_PROVIDER:
#   NSE_OFFICIAL_EOD  Official NSE published daily index-close files
#                     (nsearchives.nseindia.com/content/indices/ind_close_all_*.csv)
#   LICENSED          Authorized NSE product or licensed vendor REST API
#   CSV_IMPORT        Emergency folder of official NSE/Nifty CSVs
#   YAHOO             Optional third-party fallback (NOT an NSE source)
#
# Do not point DATA_PROVIDER at unofficial website XHR/scrape endpoints.
# ---------------------------------------------------------------------------
DATA_PROVIDER=NSE_OFFICIAL_EOD
FALLBACK_PROVIDER=NONE
NSE_DATA_MODE=EOD

# Licensed / authorized API (required when DATA_PROVIDER=LICENSED)
NSE_API_KEY=
NSE_API_SECRET=
NSE_BASE_URL=
# Expected licensed API shape is documented in README.

# Official published EOD file location (NSE archives)
NSE_OFFICIAL_EOD_BASE_URL=https://nsearchives.nseindia.com/content/indices
NSE_BHAV_BASE_URL=https://nsearchives.nseindia.com/products/content
NSE_BHAV_HISTORICAL_BASE_URL=https://nsearchives.nseindia.com/content/historical/EQUITIES
NSE_PR_BASE_URL=https://nsearchives.nseindia.com/archives/equities/bhavcopy/pr
NSE_CONSTITUENT_BASE_URL=https://nsearchives.nseindia.com/content/indices
NSE_HISTORICAL_START=2015-01-01
STOCK_HISTORICAL_START=2020-01-01
STOCK_BHAV_CRON=45 18 * * 1-5
EQUITY_FUNDAMENTAL_BASE_URL=
EQUITY_FUNDAMENTAL_API_KEY=

# Licensed news / event feed (optional). Official NSE/AMFI files have no headlines.
# Expected GET {MARKET_NEWS_BASE_URL}/search?q=&name=&symbol= → { items: [{ headline, source, date, url? }] }
# Without this, the Why box shows price/NAV evidence only — never invented news.
MARKET_NEWS_BASE_URL=
MARKET_NEWS_API_KEY=

# Emergency official-CSV folder (not the daily workflow)
CSV_IMPORT_DIR=./data/imports

# Optional third-party fallback only
YAHOO_BASE_URL=https://query1.finance.yahoo.com

PROVIDER_MIN_INTERVAL_MS=1500
PROVIDER_MAX_RETRIES=5

# Scheduler — default after NSE cash-market close
SCHEDULER_CRON=30 18 * * 1-5
SCHEDULER_TZ=Asia/Kolkata

# Local AI / ML (Ollama on this machine). No paid cloud inference.
# Pull models yourself: ollama pull qwen2.5:7b && ollama pull deepseek-r1:8b
# The app never auto-downloads weights.
LOCAL_AI_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_MODEL_ANALYST=
AI_MODEL_REASONER=
AI_MODEL_FAST=
AI_MODEL_EMBEDDING=

# Legacy optional cloud narration — unused by the local research engine.
# Leave empty. LocalAIService will not call these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_ANALYSIS_ENABLED=false

ADMIN_USER=
ADMIN_PASSWORD=

HISTORICAL_LOOKBACK_YEARS=max
ATH_METHODOLOGY=closing

# Mutual funds — official AMFI NAV files (not unofficial website scrapers)
MF_PROVIDER=AMFI
AMFI_NAVALL_URL=https://www.amfiindia.com/spages/NAVAll.txt
AMFI_NAV_HISTORY_URL=https://portal.amfiindia.com/DownloadNAVHistoryReport_Po.aspx
MF_HISTORICAL_START=2018-01-01
MF_NAV_CRON=0 22 * * 1-6
MF_LICENSED_BASE_URL=
MF_API_KEY=
